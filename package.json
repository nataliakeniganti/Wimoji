{
  "name": "wimoji",
  "version": "1.0.0",
  "description": "Open vector emoji library and SVG command-line exporter",
  "type": "module",
  "bin": {
    "wimoji": "dist-cli/wimoji.js"
  },
  "files": [
    "dist-cli/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:cli": "tsx scripts/buildCli.ts",
    "prepack": "npm run build:cli",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-cli server.js",
    "lint": "tsc --noEmit",
    "generate:svgs": "tsx scripts/generateSvgs.ts"
  },
  "devDependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "emojibase-data": "^18.0.0",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
